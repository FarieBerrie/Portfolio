# Copy to .env and fill in real values.
PORT=3001

# Long random string used to sign admin login tokens. Required when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-string

# The admin account is created on first start if it doesn't exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Optional: the site's public address, used in link previews (e.g. https://yourname.dev).
# Defaults to the address the request came in on.
# PUBLIC_URL=https://yourname.dev

# Optional: where the SQLite database file lives (defaults to server/data/portfolio.db).
# DATABASE_FILE=./data/portfolio.db
